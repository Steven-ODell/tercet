{
  "name": "tercet",
  "version": "0.1.6",
  "description": "A terminal client (TUI) for T3 Code: threads, transcripts, diffs and a composer in your terminal.",
  "keywords": ["t3-code", "t3", "tui", "terminal", "cli", "opentui", "ai-coding-agent"],
  "private": true,
  "type": "module",
  "engines": { "bun": ">=1.4.0" },
  "bin": {
    "tercet": "dist/tercet.js"
  },
  "workspaces": [
    "vendor/t3/packages/*"
  ],
  "scripts": {
    "build": "scripts/build",
    "dev": "bun src/main.tsx",
    "check": "scripts/check",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "acceptance": "scripts/acceptance.sh",
    "sync-upstream": "scripts/sync-upstream",
    "release": "scripts/release"
  },
  "dependencies": {
    "@opentui/core": "0.8.3"
  },
  "devDependencies": {
    "@noble/hashes": "1.8.0",
    "@opentui/react": "0.8.3",
    "@types/bun": "^1.3.0",
    "@types/react": "~19.3.0",
    "@xterm/headless": "6.0.0",
    "dictionary-en": "4.0.0",
    "effect": "4.1.2",
    "nspell": "2.1.5",
    "react": "19.3.0",
    "typescript": "7.0.2"
  }
}
